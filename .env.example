# Copy to .env and fill in. Never commit or share .env.
GNANI_API_KEY=
NARRATOR_PROVIDER=gnani
# Analytics dashboard (Task 2). STATS_KEY protects /api/stats and /stats/.
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob store;
# leave it empty locally and events are written to ./.data/ instead.
STATS_KEY=
BLOB_READ_WRITE_TOKEN=
# Optional
SARVAM_API_KEY=
CALLER_VOICE=Shubham
REPLY_VOICE=Shivani
NARRATOR_VOICE=Avinash
